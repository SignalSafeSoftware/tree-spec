{
  "name": "@signalsafe/tree-spec",
  "version": "0.4.6",
  "description": "TypeScript types, graph helpers, compiler utilities, and linting for the TreeSpec decision-tree format.",
  "keywords": [
    "compiler",
    "decision-tree",
    "graph",
    "lint",
    "phishing",
    "scenario",
    "schema",
    "security-awareness",
    "signalsafe",
    "training",
    "tree-spec",
    "typescript",
    "wire-format"
  ],
  "homepage": "https://github.com/SignalSafeSoftware/tree-spec#readme",
  "bugs": {
    "url": "https://github.com/SignalSafeSoftware/tree-spec/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignalSafeSoftware/tree-spec.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "yarn typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "pack:local": "yarn build && mkdir -p artifacts && npm pack --ignore-scripts --pack-destination artifacts",
    "publish:dry-run": "npm publish --dry-run",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test": "yarn build && vitest run",
    "test:coverage": "yarn test --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=19.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
