{
    "name": "@signalsafe/tree-spec",
    "version": "0.4.3",
    "type": "module",
    "description": "TypeScript types, graph helpers, compiler utilities, and linting for the TreeSpec decision-tree format.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SignalSafeSoftware/tree-spec.git"
    },
    "bugs": {
        "url": "https://github.com/SignalSafeSoftware/tree-spec/issues"
    },
    "homepage": "https://github.com/SignalSafeSoftware/tree-spec#readme",
    "keywords": [
        "tree-spec",
        "decision-tree",
        "scenario",
        "training",
        "phishing",
        "security-awareness",
        "typescript",
        "schema",
        "wire-format",
        "graph",
        "lint",
        "compiler",
        "signalsafe"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "docs"
    ],
    "engines": {
        "node": ">=19.0.0"
    },
    "packageManager": "yarn@1.22.22",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "yarn typecheck",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
        "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
        "pack:local": "yarn build && mkdir -p artifacts && npm pack --ignore-scripts --pack-destination artifacts",
        "publish:dry-run": "npm publish --dry-run",
        "smoke:package": "node scripts/smoke-package.mjs",
        "prepublishOnly": "npm run build",
        "prepare": "npm run build",
        "test": "yarn build && vitest run",
        "test:coverage": "yarn test --coverage"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "@vitest/coverage-v8": "5.0.4",
        "vitest": "5.0.4",
        "vite": "^8.3.4"
    }
}
