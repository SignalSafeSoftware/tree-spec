{
    "name": "tree-spec-workspace",
    "private": true,
    "version": "0.0.0",
    "packageManager": "yarn@1.22.22",
    "workspaces": [
        "typescript"
    ],
    "scripts": {
        "build": "yarn --cwd typescript build",
        "lint": "yarn --cwd typescript lint",
        "typecheck": "yarn --cwd typescript typecheck",
        "typecheck:examples": "yarn --cwd typescript typecheck:examples",
        "test": "yarn --cwd typescript test",
        "test:coverage": "yarn --cwd typescript test:coverage",
        "smoke:package": "yarn --cwd typescript smoke:package",
        "publish:dry-run": "yarn --cwd typescript publish:dry-run",
        "check:distributions": "node scripts/check-distributions.mjs",
        "pack:local": "yarn --cwd typescript pack:local"
    },
    "resolutions": {
        "source-map-js": "^1.2.2"
    }
}
